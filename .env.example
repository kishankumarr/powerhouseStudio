# Optional: a form service endpoint that accepts JSON POSTs (Formspree, Getform, Basin...).
# Without it, the contact form opens the visitor's email app with the enquiry filled in.
NEXT_PUBLIC_FORM_ENDPOINT=

# Public URL of the deployed site, used for canonical URLs, sitemap and social images.
NEXT_PUBLIC_SITE_URL=https://powerhousestudios.in
